repositories:
  - name: traefik
    url: https://traefik.github.io/charts

helmDefaults:
  wait: true
  # Seconds helm waits for the release (stack var helm_timeout; the helmfile section of a stack sets it for all).
  timeout: {{ .Values | get "helm_timeout" 600 }}

releases:
  - name: traefik
    namespace: traefik
    createNamespace: true
    chart: traefik/traefik
    version: {{ .Values.chart_version | quote }}
    values:
      - values.yaml.gotmpl