repositories:
  - name: minio
    url: {{ .Values | get "nexus_charts" "https://charts.min.io/" | quote }}
helmDefaults:
  wait: true
  # Seconds helm waits for the release (stack var helm_timeout; the helmfile section of a stack sets it for all).
  timeout: {{ .Values | get "helm_timeout" 600 }}
releases:
  - name: minio
    namespace: storage
    createNamespace: true
    chart: minio/minio
    version: {{ .Values.chart_version | quote }}
    values: [values.yaml.gotmpl]
  - name: minio-bucket
    namespace: storage
    chart: ./charts/minio-bucket
    needs: [storage/minio]
    values: [values-bucket.yaml.gotmpl]
