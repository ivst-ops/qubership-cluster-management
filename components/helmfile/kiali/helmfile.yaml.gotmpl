repositories:
  - name: kiali
    url: {{ .Values | get "nexus_charts" "https://kiali.org/helm-charts" | quote }}
helmDefaults:
  wait: true
  # Seconds helm waits for the release (stack var helm_timeout; the helmfile section of a stack sets it for all).
  timeout: {{ .Values | get "helm_timeout" 600 }}
releases:
  - name: kiali-operator
    namespace: kiali-operator
    createNamespace: true
    chart: kiali/kiali-operator
    version: {{ .Values.chart_version | quote }}
    hooks:
      # Chart into helm's content cache, with retries, before helm diff and upgrade (../warm-chart.sh).
      - events: [prepare]
        showlogs: true
        command: sh
        args: [../warm-chart.sh, kiali/kiali-operator, {{ .Values.chart_version | quote }}]
    disableValidationOnInstall: true
    values:
      - values.yaml.gotmpl
