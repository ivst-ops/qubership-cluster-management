repositories:
  - name: argo
    url: {{ .Values | get "nexus_charts" "https://argoproj.github.io/argo-helm" | quote }}
helmDefaults:
  wait: true
  # Seconds helm waits for the release (stack var helm_timeout; the helmfile section of a stack sets it for all).
  timeout: {{ .Values | get "helm_timeout" 600 }}
releases:
  - name: argocd
    namespace: argocd
    createNamespace: true
    chart: argo/argo-cd
    version: {{ .Values.chart_version | quote }}
    hooks:
      # Chart into helm's content cache, with retries, before helm diff and upgrade (../warm-chart.sh).
      - events: [prepare]
        showlogs: true
        command: sh
        args: [../warm-chart.sh, argo/argo-cd, {{ .Values.chart_version | quote }}]
    values:
      - values.yaml.gotmpl
